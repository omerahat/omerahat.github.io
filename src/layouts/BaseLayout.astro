---
import { profile } from '../data/profile';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} | ${profile.headline}`,
  description = profile.tagline,
} = Astro.props;

const site = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, site);
const assetBaseUrl = new URL(import.meta.env.BASE_URL, site);
const faviconUrl = new URL('favicon.svg', assetBaseUrl);
const imageUrl = new URL('og-card.svg', assetBaseUrl);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.headline,
  description: profile.tagline,
  email: profile.email,
  url: canonicalUrl.toString(),
  sameAs: [profile.linkedin, profile.github],
  homeLocation: {
    '@type': 'Place',
    name: profile.location,
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: profile.education.institution,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff7e6" />
    <link rel="canonical" href={canonicalUrl.toString()} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl.toString()} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:image" content={imageUrl.toString()} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Omer Ahat portfolio preview" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.toString()} />
    <meta name="twitter:image:alt" content="Omer Ahat portfolio preview" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
