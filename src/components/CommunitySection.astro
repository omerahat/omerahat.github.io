---
import { profile } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
---

<section id="community" class="community section" aria-labelledby="community-title">
  <div class="container">
    <SectionHeading
      headingId="community-title"
      eyebrow="Community"
      title="Build the room, not just the project"
      description="Technical leadership has always been part of the work: sharing context, growing communities, and making space for others to contribute."
    />

    <ul class="community__grid">
      {profile.community.map((entry) => (
        <li>
          <article class="community__card card">
            <p class="eyebrow">{entry.organization}</p>
            <h3>{entry.role}</h3>
            <p class="community__period">{entry.period}</p>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .community {
    border-block: var(--border-divider);
    background: var(--color-surface-solid);
  }

  .community__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .community__grid > li {
    min-width: 0;
  }

  .community__grid > li:nth-child(odd) {
    grid-column: span 7;
  }

  .community__grid > li:nth-child(even) {
    grid-column: span 5;
  }

  .community__card {
    display: grid;
    align-content: start;
    gap: 0.65rem;
    min-height: 100%;
  }

  .community__grid > li:nth-child(odd) .community__card {
    border-color: var(--color-accent);
    background: var(--surface-raised);
  }

  .community__grid > li:nth-child(even) .community__card {
    box-shadow: none;
  }

  .community__card h3 {
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
  }

  .community__period {
    color: var(--color-orange);
    font-size: 0.88rem;
    font-weight: 800;
  }

  @media (max-width: 44rem) {
    .community__grid {
      grid-template-columns: 1fr;
    }

    .community__grid > li:nth-child(odd),
    .community__grid > li:nth-child(even) {
      grid-column: auto;
    }
  }
</style>
