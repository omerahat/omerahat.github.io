---
import { profile } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
---

<section id="contact" class="contact section" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact__panel">
      <SectionHeading
        headingId="contact-title"
        eyebrow="Contact"
        title="Have a useful problem to solve?"
        description="Email is the best place to start. I am open to thoughtful conversations about AI, research, and building products that earn trust."
      />

      <div class="contact__actions">
        <ul class="contact__links" aria-label="Public contact links">
          <li>
            <a class="contact__link" href={`mailto:${profile.email}`}>{profile.email}</a>
          </li>
          <li>
            <a
              class="contact__link"
              href={profile.linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn <span aria-hidden="true">&nearr;</span>
            </a>
          </li>
          <li>
            <a
              class="contact__link"
              href={profile.github}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub <span aria-hidden="true">&nearr;</span>
            </a>
          </li>
        </ul>

        <a class="button button--primary contact__resume" href={profile.resumeRequestHref}>
          Request the resume <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <p class="contact__fallback">If your mail client is not configured, copy the email above.</p>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-yellow);
  }

  .contact__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.75fr);
    grid-template-areas:
      'intro actions'
      'fallback fallback';
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(1.5rem, 5vw, 4rem);
    border: var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    box-shadow: var(--shadow-card);
    backdrop-filter: var(--surface-backdrop-filter);
    -webkit-backdrop-filter: var(--surface-backdrop-filter);
  }

  .contact__panel > :global(.section-heading) {
    grid-area: intro;
  }

  .contact__actions {
    display: grid;
    align-content: center;
    grid-area: actions;
    gap: var(--space-5);
    min-width: 0;
    padding-inline-start: clamp(1.25rem, 3vw, 2.5rem);
    border-inline-start: var(--border-divider);
  }

  .contact__links {
    display: grid;
    min-width: 0;
    border-block-start: var(--border-divider);
  }

  .contact__link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
    padding-block: 0.8rem;
    border-block-end: var(--border-divider);
    color: var(--color-foreground);
    font-weight: 750;
    text-decoration: none;
  }

  .contact__link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .contact__resume {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    padding: 0.85rem 1.15rem;
    border: var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-foreground);
    color: var(--color-surface-solid);
    font-weight: 750;
    text-decoration: none;
    transition: var(--motion-interactive);
  }

  .contact__resume:hover {
    color: var(--color-surface-solid);
    background: var(--color-accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact__resume:hover {
      transform: translateY(-0.1rem);
    }
  }

  .contact__fallback {
    grid-area: fallback;
    color: var(--color-foreground-muted);
    font-size: 0.88rem;
  }

  @media (max-width: 46rem) {
    .contact__panel {
      grid-template-columns: 1fr;
      grid-template-areas:
        'intro'
        'actions'
        'fallback';
      gap: 2rem;
    }

    .contact__actions {
      align-content: start;
      padding-inline-start: 0;
      padding-block-start: var(--space-5);
      border-inline-start: 0;
      border-block-start: var(--border-divider);
    }
  }

  @media (max-width: 28rem) {
    .contact__resume {
      width: 100%;
    }
  }
</style>
