---
import { profile } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
---

<section id="skills" class="skills section" aria-labelledby="skills-title">
  <div class="container">
    <SectionHeading
      headingId="skills-title"
      eyebrow="Toolkit"
      title="Skills for the full loop"
      description="From modeling and explainability to data systems, APIs, and the tools that make good work repeatable."
    />

    <div class="skills__index">
      {profile.skills.map((group) => (
        <article class="skills__group">
          <h3>{group.category}</h3>
          <ul aria-label={`${group.category} skills`}>
            {group.items.map((item) => (
              <li>
                <span class="skills__item">{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    border-block: var(--border-divider);
    background: var(--color-surface-solid);
  }

  .skills__index {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-block: var(--border-strong);
  }

  .skills__group {
    display: grid;
    grid-template-columns: minmax(10rem, 0.35fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
    min-width: 0;
    padding-block: 1.35rem;
  }

  .skills__group + .skills__group {
    border-top: var(--border-divider);
  }

  .skills__group h3 {
    color: var(--color-accent);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .skills__group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0;
    min-width: 0;
  }

  .skills__group li {
    display: inline-flex;
    align-items: center;
  }

  .skills__group li:not(:last-child)::after {
    margin-inline: 0.7rem;
    color: var(--color-border);
    content: '/';
    font-weight: 400;
  }

  .skills__item {
    color: var(--color-foreground);
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    font-weight: 700;
    line-height: 1.4;
  }

  @media (max-width: 44rem) {
    .skills__group {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding-block: 1.15rem;
    }
  }

  @media (max-width: 20rem) {
    .skills__group li:not(:last-child)::after {
      margin-inline: 0.5rem;
    }
  }
</style>
