---
import { profile } from '../data/profile';

const homeHref = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <a class="site-footer__identity" href={homeHref}>{profile.name}</a>
      <p>{profile.headline}</p>
    </div>

    <nav aria-label="Footer links">
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>

    <p class="site-footer__copyright">© {new Date().getFullYear()} {profile.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-7);
    border-top: 1px solid rgb(255 247 230 / 0.18);
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-5) var(--space-6);
    min-width: 0;
  }

  .site-footer__identity {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-block: 0.2rem;
    color: var(--color-surface-solid);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 750;
    letter-spacing: var(--tracking-display-sm);
    text-decoration: none;
  }

  .site-footer p {
    color: var(--color-background);
    font-size: 0.85rem;
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem 1rem;
  }

  .site-footer nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-block: 0.35rem;
    color: var(--color-surface-solid);
    font-size: 0.88rem;
    font-weight: 750;
    text-decoration: none;
  }

  .site-footer nav a:hover,
  .site-footer__identity:hover {
    color: var(--color-accent-soft);
  }

  .site-footer a:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-accent-soft);
    outline-offset: var(--focus-ring-offset);
    box-shadow: none;
  }

  .site-footer__copyright {
    grid-column: 1 / -1;
    padding-top: var(--space-4);
    border-top: 1px solid rgb(255 247 230 / 0.18);
  }

  @media (max-width: 40rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      align-items: start;
      gap: var(--space-4);
    }

    .site-footer nav {
      justify-content: flex-start;
    }
  }
</style>
