---
import { getCollection, render } from 'astro:content';
import SectionHeading from './SectionHeading.astro';

const experiences = (await getCollection('experience')).sort(
  (first, second) => first.data.order - second.data.order,
);

const renderedExperiences = await Promise.all(
  experiences.map(async (experience) => ({
    experience,
    Content: (await render(experience)).Content,
  })),
);
---

<section id="experience" class="experience section" aria-labelledby="experience-title">
  <div class="container">
    <SectionHeading
      headingId="experience-title"
      eyebrow="Experience"
      title="Research, products, and systems"
      description="A reverse-chronological path through applied AI, software engineering, and research."
    />

    <ol class="experience__timeline">
      {renderedExperiences.map(({ experience, Content }) => (
        <li
          class:list={[
            'experience__item',
            { 'experience__item--current': experience.data.current },
          ]}
        >
          <span class="experience__marker" aria-hidden="true"></span>
          <article class="experience__card" itemscope itemtype="https://schema.org/JobPosting">
            <header class="experience__header">
              <div>
                <p class="eyebrow">{experience.data.company}</p>
                <h3>{experience.data.role}</h3>
              </div>
              <div class="experience__meta">
                {experience.data.current && <span class="experience__current">Current</span>}
                <time itemprop="startDate" datetime={experience.data.startDate}>
                  {experience.data.period}
                </time>
                {experience.data.endDate && (
                  <meta itemprop="endDate" content={experience.data.endDate} />
                )}
                {experience.data.location && <span>{experience.data.location}</span>}
              </div>
            </header>

            <div class="experience__body"><Content /></div>

            <ul class="experience__focus" aria-label={`${experience.data.company} focus areas`}>
              {experience.data.focus.map((focus) => <li class="pill">{focus}</li>)}
            </ul>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .experience {
    background: var(--color-paper);
  }

  .experience__timeline {
    position: relative;
    display: grid;
    max-width: 60rem;
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .experience__timeline::before {
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: 0.65rem;
    width: 2px;
    background: var(--color-line);
    content: '';
  }

  .experience__item {
    position: relative;
    padding-left: 2.75rem;
  }

  .experience__marker {
    position: absolute;
    z-index: 1;
    top: 1.7rem;
    left: 0;
    width: 1.35rem;
    height: 1.35rem;
    border: 3px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-paper);
  }

  .experience__item--current .experience__marker {
    border-color: var(--color-orange);
    background: var(--color-yellow);
    box-shadow: 0.15rem 0.15rem 0 var(--color-ink);
  }

  .experience__card {
    display: grid;
    gap: 1.15rem;
    padding: var(--card-padding);
    border: var(--card-border);
    border-radius: var(--card-radius);
    background: var(--color-white);
  }

  .experience__item--current .experience__card {
    border: 2px solid var(--color-ink);
    box-shadow: 0.35rem 0.35rem 0 var(--color-yellow);
  }

  .experience__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .experience__header h3 {
    margin-top: 0.45rem;
    font-size: clamp(1.45rem, 2.5vw, 2.1rem);
  }

  .experience__meta {
    display: grid;
    flex-shrink: 0;
    justify-items: end;
    gap: 0.2rem;
    color: var(--color-muted);
    font-size: 0.88rem;
    text-align: right;
  }

  .experience__current {
    padding: 0.25rem 0.55rem;
    border-radius: var(--pill-radius);
    background: var(--color-orange);
    color: var(--color-white);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .experience__body :global(p) {
    max-width: 48rem;
    color: var(--color-muted);
  }

  .experience__focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding-top: 0.2rem;
  }

  .experience__focus .pill {
    background: var(--color-paper);
    font-size: 0.8rem;
  }

  @media (max-width: 42rem) {
    .experience__header {
      display: grid;
      gap: 1rem;
    }

    .experience__meta {
      justify-items: start;
      text-align: left;
    }
  }

  @media (max-width: 28rem) {
    .experience__item {
      padding-left: 2rem;
    }

    .experience__timeline::before {
      left: 0.45rem;
    }

    .experience__marker {
      width: 1rem;
      height: 1rem;
    }
  }
</style>
