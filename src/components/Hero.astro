---
import { profile } from '../data/profile';
import IllustratedAvatar from './IllustratedAvatar.astro';
---

<section
  class="hero section"
  aria-labelledby="hero-title"
  aria-describedby="hero-tagline hero-roles hero-availability"
>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">AI / RESEARCH / SYSTEMS</p>
      <h1 id="hero-title">{profile.headline}</h1>
      <p id="hero-tagline" class="hero__tagline">{profile.tagline}</p>
      <p id="hero-roles" class="hero__roles">
        <strong>Open to:</strong> {profile.targetRoles.join(' · ')}
      </p>
      <p id="hero-availability" class="hero__availability">{profile.availability}</p>

      <div class="hero__actions">
        <a class="button button--primary" href="#work">
          See selected work <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="button button--secondary" href={profile.resumeRequestHref}>Request the resume</a>
      </div>

      <ul class="hero__meta" aria-label="Profile details">
        <li>
          <span class="hero__meta-icon" aria-hidden="true">+</span>
          <span>Computer Engineer, {profile.graduation}</span>
        </li>
        <li>
          <span class="hero__meta-icon" aria-hidden="true">+</span>
          <span>{profile.location}</span>
        </li>
      </ul>
    </div>

    <figure class="hero__art">
      <div class="hero__avatar-wrap">
        <IllustratedAvatar />
      </div>
      <figcaption class="hero__caption">
        <span>Based in</span>
        <strong>{profile.location}</strong>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(3.5rem, 7vw, 6.5rem) clamp(3.25rem, 6vw, 5rem);
  }

  .hero::before {
    position: absolute;
    top: 9%;
    right: -8rem;
    width: 18rem;
    height: 18rem;
    border: 2px solid var(--color-accent-warm);
    border-radius: 50%;
    content: '';
    opacity: 0.55;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.65fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    max-width: 50rem;
    animation: hero-opening-in 260ms var(--motion-ease-out) both;
  }

  .hero h1 {
    max-width: 11ch;
    margin-top: 0.85rem;
    text-wrap: balance;
  }

  .hero__tagline {
    max-width: 35rem;
    margin-top: 1.25rem;
    color: var(--color-foreground-muted);
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    line-height: 1.35;
  }

  .hero__roles,
  .hero__availability {
    max-width: 38rem;
    color: var(--color-foreground-muted);
    font-size: 0.92rem;
  }

  .hero__roles {
    margin-top: 1rem;
  }

  .hero__roles strong {
    color: var(--color-foreground);
    font-weight: 800;
  }

  .hero__availability {
    margin-top: 0.35rem;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
  }

  .hero__meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-foreground);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .hero__meta-icon {
    display: grid;
    width: 1.45rem;
    height: 1.45rem;
    place-items: center;
    border-radius: 50%;
    background: var(--color-accent-warm);
    font-size: 1.15rem;
    line-height: 1;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.75rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0.85rem 1.15rem;
    border: var(--border-strong);
    border-radius: var(--radius-pill);
    font-weight: 750;
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .button:hover {
    color: var(--color-foreground);
  }

  @media (hover: hover) and (pointer: fine) {
    .button:hover {
      transform: translate(-0.15rem, -0.15rem);
    }
  }

  .button--primary {
    background: var(--color-foreground);
    color: var(--color-background);
    box-shadow: 0.25rem 0.25rem 0 var(--color-accent);
  }

  .button--primary:hover {
    color: var(--color-background);
    background: var(--color-accent);
    box-shadow: 0.25rem 0.25rem 0 var(--color-foreground);
  }

  .button--secondary {
    background: var(--color-accent-soft);
    color: var(--color-foreground);
    box-shadow: 0.25rem 0.25rem 0 var(--color-foreground);
  }

  .button--secondary:hover {
    background: var(--color-accent-warm);
  }

  .hero__art {
    position: relative;
    display: grid;
    justify-items: center;
    margin: 0;
    padding: 0.75rem;
  }

  .hero__art::before {
    position: absolute;
    inset: 8% 9% 9% 8%;
    border: var(--border-strong);
    border-radius: 48% 52% 45% 55%;
    background: var(--color-surface-solid);
    content: '';
    transform: rotate(7deg);
  }

  .hero__avatar-wrap {
    position: relative;
    z-index: 1;
    width: min(100%, 20rem);
    transform: rotate(-4deg);
  }

  .hero__caption {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.1rem;
    margin-top: -0.5rem;
    margin-left: auto;
    padding: 0.7rem 1rem;
    border: var(--border-strong);
    border-radius: 0.75rem;
    background: var(--color-accent-soft);
    box-shadow: 0.25rem 0.25rem 0 var(--color-foreground);
    transform: rotate(3deg);
  }

  .hero__caption span {
    color: var(--color-foreground-muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero__caption strong {
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  @media (max-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(13rem, 0.8fr);
      gap: 2rem;
    }
  }

  @media (max-width: 48rem) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__copy {
      max-width: 42rem;
    }

    .hero__art {
      max-width: 28rem;
      margin-inline: auto;
    }
  }

  @media (max-width: 28rem) {
    .hero__actions,
    .hero__actions .button {
      width: 100%;
    }
  }

  @keyframes hero-opening-in {
    from {
      transform: translateY(0.75rem);
    }

    to {
      transform: translateY(0);
    }
  }

  @keyframes hero-opening-fade {
    from {
      opacity: 0.7;
    }

    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__copy {
      animation: hero-opening-fade 180ms ease-out both !important;
    }
  }
</style>
