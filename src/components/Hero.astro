---
import { profile } from '../data/profile';
import IllustratedAvatar from './IllustratedAvatar.astro';
---

<section class="hero section" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">AI / RESEARCH / SYSTEMS</p>
      <h1 id="hero-title">{profile.headline}</h1>
      <p class="hero__tagline">{profile.tagline}</p>

      <ul class="hero__meta" aria-label="Profile details">
        <li>
          <span class="hero__meta-icon" aria-hidden="true">+</span>
          <span>Computer Engineer, {profile.graduation}</span>
        </li>
        <li>
          <span class="hero__meta-icon" aria-hidden="true">+</span>
          <span>{profile.location}</span>
        </li>
      </ul>

      <div class="hero__actions">
        <a class="button button--primary" href="#work">
          See selected work <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="button button--secondary" href={profile.resumeRequestHref}>Request the resume</a>
      </div>
    </div>

    <figure class="hero__art">
      <div class="hero__avatar-wrap">
        <IllustratedAvatar />
      </div>
      <figcaption class="hero__caption">
        <span>Based in</span>
        <strong>{profile.location}</strong>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(4.5rem, 10vw, 9rem) clamp(4rem, 8vw, 7rem);
  }

  .hero::before {
    position: absolute;
    top: 9%;
    right: -8rem;
    width: 18rem;
    height: 18rem;
    border: 2px solid var(--color-coral);
    border-radius: 50%;
    content: '';
    opacity: 0.55;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    align-items: center;
    gap: clamp(2.5rem, 8vw, 7rem);
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    max-width: 50rem;
  }

  .hero h1 {
    max-width: 12ch;
    margin-top: 1rem;
    text-wrap: balance;
  }

  .hero__tagline {
    max-width: 35rem;
    margin-top: 1.75rem;
    color: var(--color-muted);
    font-size: clamp(1.2rem, 2.4vw, 1.65rem);
    line-height: 1.35;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 1.75rem;
  }

  .hero__meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .hero__meta-icon {
    display: grid;
    width: 1.45rem;
    height: 1.45rem;
    place-items: center;
    border-radius: 50%;
    background: var(--color-coral);
    font-size: 1.15rem;
    line-height: 1;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.25rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0.85rem 1.15rem;
    border: 2px solid var(--color-ink);
    border-radius: var(--pill-radius);
    font-weight: 750;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
  }

  .button:hover {
    color: var(--color-ink);
    transform: translate(-0.15rem, -0.15rem);
  }

  .button--primary {
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: 0.25rem 0.25rem 0 var(--color-orange);
  }

  .button--primary:hover {
    color: var(--color-paper);
    background: var(--color-orange);
    box-shadow: 0.25rem 0.25rem 0 var(--color-ink);
  }

  .button--secondary {
    background: var(--color-yellow);
    color: var(--color-ink);
    box-shadow: 0.25rem 0.25rem 0 var(--color-ink);
  }

  .button--secondary:hover {
    background: var(--color-coral);
  }

  .hero__art {
    position: relative;
    display: grid;
    justify-items: center;
    margin: 0;
    padding: 1.5rem;
  }

  .hero__art::before {
    position: absolute;
    inset: 8% 9% 9% 8%;
    border: 2px solid var(--color-ink);
    border-radius: 48% 52% 45% 55%;
    background: var(--color-white);
    content: '';
    transform: rotate(7deg);
  }

  .hero__avatar-wrap {
    position: relative;
    z-index: 1;
    width: min(100%, 25rem);
    transform: rotate(-4deg);
  }

  .hero__caption {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.1rem;
    margin-top: -1rem;
    margin-left: auto;
    padding: 0.7rem 1rem;
    border: 2px solid var(--color-ink);
    border-radius: 0.75rem;
    background: var(--color-yellow);
    box-shadow: 0.25rem 0.25rem 0 var(--color-ink);
    transform: rotate(3deg);
  }

  .hero__caption span {
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero__caption strong {
    font-family: 'Bricolage Grotesque Variable', 'Bricolage Grotesque', sans-serif;
    font-size: 1.1rem;
  }

  @media (max-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.75fr);
      gap: 2.5rem;
    }
  }

  @media (max-width: 48rem) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__copy {
      max-width: 42rem;
    }

    .hero__art {
      max-width: 28rem;
      margin-inline: auto;
    }
  }

  @media (max-width: 28rem) {
    .hero__actions,
    .hero__actions .button {
      width: 100%;
    }
  }
</style>
