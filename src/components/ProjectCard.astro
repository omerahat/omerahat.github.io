---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<article class="project-card">
  <header class="project-card__header">
    <p class="eyebrow">{data.eyebrow}</p>
    <h3>{data.title}</h3>
  </header>

  <p class="project-card__summary">{data.summary}</p>

  <div class="project-card__details">
    <div>
      <p class="project-card__label">Contribution</p>
      <div class="project-card__body"><Content /></div>
    </div>
    <div>
      <p class="project-card__label">Outcome</p>
      <p class="project-card__outcome">{data.outcome}</p>
    </div>
  </div>

  <div class="project-card__footer">
    <div>
      <p class="project-card__label">Signals</p>
      <ul class="project-card__list" aria-label={`${data.title} metrics`}>
        {data.metrics.map((metric) => <li class="pill">{metric}</li>)}
      </ul>
    </div>

    <div>
      <p class="project-card__label">Technologies</p>
      <ul class="project-card__list" aria-label={`${data.title} technologies`}>
        {data.technologies.map((technology) => <li class="pill">{technology}</li>)}
      </ul>
    </div>

    {data.href && (
      <a class="project-card__link" href={data.href} target="_blank" rel="noopener noreferrer">
        {data.hrefLabel ?? 'View project'} <span aria-hidden="true">&rarr;</span>
      </a>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    gap: 1.4rem;
    padding: var(--card-padding);
    border: 2px solid var(--color-ink);
    border-radius: var(--card-radius);
    background: var(--color-white);
    box-shadow: 0.35rem 0.35rem 0 var(--color-line);
  }

  .project-card__header {
    display: grid;
    gap: 0.6rem;
  }

  .project-card h3 {
    max-width: 18ch;
    font-size: clamp(1.75rem, 3vw, 2.6rem);
  }

  .project-card__summary {
    max-width: 42rem;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .project-card__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .project-card__label {
    color: var(--color-orange);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-card__body,
  .project-card__outcome {
    margin-top: 0.45rem;
  }

  .project-card__body :global(p) {
    margin: 0;
  }

  .project-card__footer {
    display: grid;
    gap: 1.15rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .project-card__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.6rem;
  }

  .project-card__list .pill {
    background: var(--color-paper);
    font-size: 0.8rem;
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.45rem;
    padding: 0.7rem 0.95rem;
    border: 2px solid var(--color-ink);
    border-radius: var(--pill-radius);
    background: var(--color-yellow);
    font-weight: 800;
    text-decoration: none;
  }

  .project-card__link:hover {
    color: var(--color-ink);
    background: var(--color-coral);
    transform: translate(-0.1rem, -0.1rem);
  }

  @media (max-width: 36rem) {
    .project-card__details {
      grid-template-columns: 1fr;
    }
  }
</style>
