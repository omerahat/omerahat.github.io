---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<article class:list={['project-card', { 'project-card--featured': featured }]}>
  <header class="project-card__header">
    <p class="eyebrow">{data.eyebrow}</p>
    <h3>{data.title}</h3>
  </header>

  <p class="project-card__summary">{data.summary}</p>

  <div class="project-card__details">
    <div>
      <p class="project-card__label">Contribution</p>
      <div class="project-card__body"><Content /></div>
    </div>
    <div>
      <p class="project-card__label">Outcome</p>
      <p class="project-card__outcome">{data.outcome}</p>
    </div>
  </div>

  {data.poster && data.posterAlt && (
    <figure class="project-card__poster">
      <a
        class="project-card__poster-link"
        href={data.poster}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Open ${data.title} research poster at full size`}
      >
        <img
          src={data.poster}
          alt={data.posterAlt}
          loading="lazy"
          decoding="async"
        />
      </a>
    </figure>
  )}

  <div class="project-card__footer">
    <div>
      <p class="project-card__label">Signals</p>
      <ul class="project-card__list" aria-label={`${data.title} metrics`}>
        {data.metrics.map((metric) => <li class="pill">{metric}</li>)}
      </ul>
    </div>

    <div>
      <p class="project-card__label">Technologies</p>
      <ul class="project-card__list" aria-label={`${data.title} technologies`}>
        {data.technologies.map((technology) => <li class="pill">{technology}</li>)}
      </ul>
    </div>

    {(data.href || data.paperHref || data.scholarHref) && (
      <div class="project-card__links">
        {data.href && (
          <a class="project-card__link" href={data.href} target="_blank" rel="noopener noreferrer">
            {data.hrefLabel ?? 'View project'} <span aria-hidden="true">&rarr;</span>
          </a>
        )}

        {data.paperHref && (
          <a class="project-card__link" href={data.paperHref} target="_blank" rel="noopener noreferrer">
            {data.paperHrefLabel ?? 'Read paper'} <span aria-hidden="true">&rarr;</span>
          </a>
        )}

        {data.scholarHref && (
          <a class="project-card__link" href={data.scholarHref} target="_blank" rel="noopener noreferrer">
            {data.scholarHrefLabel ?? 'Google Scholar'} <span aria-hidden="true">&rarr;</span>
          </a>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--card-padding);
    border: var(--border-subtle);
    border-radius: var(--radius-card);
    background: var(--surface-card);
    box-shadow: var(--shadow-card);
    backdrop-filter: var(--surface-backdrop-filter);
    -webkit-backdrop-filter: var(--surface-backdrop-filter);
  }

  .project-card--featured {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(14rem, 0.85fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--color-accent-soft);
    box-shadow: var(--shadow-raised);
  }

  .project-card__header {
    display: grid;
    gap: 0.6rem;
  }

  .project-card h3 {
    max-width: 18ch;
    font-size: clamp(1.75rem, 3vw, 2.6rem);
  }

  .project-card--featured .project-card__header,
  .project-card--featured .project-card__summary {
    grid-column: 1;
  }

  .project-card--featured h3 {
    max-width: 14ch;
    font-size: clamp(2rem, 4vw, 3.4rem);
  }

  .project-card__summary {
    max-width: 42rem;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .project-card--featured .project-card__summary {
    max-width: 38rem;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .project-card__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .project-card--featured .project-card__details {
    grid-column: 2;
    grid-row: 1 / span 2;
    grid-template-columns: 1fr;
    align-content: start;
    align-self: stretch;
    padding-left: clamp(1rem, 3vw, 2rem);
    border-left: var(--border-divider);
  }

  .project-card__label {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-card--featured .eyebrow,
  .project-card--featured .project-card__label {
    color: var(--color-foreground);
  }

  .project-card__body,
  .project-card__outcome {
    margin-top: 0.45rem;
  }

  .project-card__body :global(p) {
    margin: 0;
  }

  .project-card__poster {
    display: grid;
    grid-column: 1 / -1;
    gap: 0.6rem;
    margin: 0;
  }

  .project-card__poster-link {
    display: block;
    overflow: hidden;
    border: var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--color-surface-solid);
    box-shadow: var(--shadow-card);
  }

  .project-card__poster-link:hover {
    color: inherit;
  }

  .project-card__poster img {
    width: 100%;
    height: auto;
  }

  .project-card__footer {
    display: grid;
    gap: 1.15rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: var(--border-divider);
  }

  .project-card--featured .project-card__footer {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    align-items: end;
  }

  .project-card__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.6rem;
  }

  .project-card__list .pill {
    background: var(--color-background);
    font-size: 0.8rem;
  }

  .project-card--featured .project-card__list .pill {
    background: var(--color-surface-solid);
  }

  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.6rem;
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.45rem;
    padding: 0.7rem 0.95rem;
    border: var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-foreground);
    color: var(--color-surface-solid);
    font-weight: 800;
    text-decoration: none;
  }

  .project-card__link:hover {
    color: var(--color-surface-solid);
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card__poster-link:hover {
      transform: translateY(-0.1rem);
    }

    .project-card__link:hover {
      transform: translateY(-0.1rem);
    }
  }

  @media (max-width: 42rem) {
    .project-card--featured {
      display: flex;
    }

    .project-card--featured .project-card__header,
    .project-card--featured .project-card__summary,
    .project-card--featured .project-card__details,
    .project-card--featured .project-card__footer {
      grid-column: auto;
      grid-row: auto;
    }

    .project-card--featured .project-card__details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-left: 0;
      border-left: 0;
    }

    .project-card--featured .project-card__footer {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .project-card__details,
    .project-card--featured .project-card__details {
      grid-template-columns: 1fr;
    }
  }
</style>
