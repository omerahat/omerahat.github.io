---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';

const featuredProjects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((first, second) => first.data.order - second.data.order);
---

<section id="work" class="projects section" aria-labelledby="work-title">
  <div class="container">
    <SectionHeading
      headingId="work-title"
      eyebrow="Selected work"
      title="Systems built to be understood"
      description="A selection of explainable AI, computer vision, and data systems built from research through delivery."
    />

    <div class="projects__grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>

<style>
  .projects {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-white);
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .projects__grid :global(.project-card:first-child) {
    grid-column: 1 / -1;
    background: var(--color-yellow);
  }

  .projects__grid :global(.project-card:first-child .project-card__list .pill) {
    background: var(--color-white);
  }

  .projects__grid :global(.project-card:first-child .eyebrow),
  .projects__grid :global(.project-card:first-child .project-card__label) {
    color: var(--color-ink);
  }

  @media (max-width: 48rem) {
    .projects__grid {
      grid-template-columns: 1fr;
    }

    .projects__grid :global(.project-card:first-child) {
      grid-column: auto;
    }
  }
</style>
