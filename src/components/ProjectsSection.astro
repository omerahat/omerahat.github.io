---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';

const featuredProjects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((first, second) => first.data.order - second.data.order);

const [featuredProject, ...supportingProjects] = featuredProjects;
---

<section id="work" class="projects section" aria-labelledby="work-title">
  <div class="container">
    <SectionHeading
      headingId="work-title"
      eyebrow="Selected work"
      title="Systems built to be understood"
      description="A selection of explainable AI, computer vision, and data systems built from research through delivery."
    />

    <div class="projects__grid">
      {featuredProject && <ProjectCard project={featuredProject} featured />}

      <div class="projects__supporting-grid">
        {supportingProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </div>
</section>

<style>
  .projects {
    border-bottom: var(--border-divider);
    background: var(--color-surface-solid);
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: 3rem;
  }

  .projects__grid > :global(.project-card--featured),
  .projects__supporting-grid {
    grid-column: 1 / -1;
  }

  .projects__supporting-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 60rem) {
    .projects__supporting-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    .projects__grid {
      grid-template-columns: 1fr;
    }

    .projects__supporting-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
